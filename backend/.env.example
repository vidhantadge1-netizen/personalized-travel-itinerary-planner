# Copy this file to .env and fill in values locally.
# Do not put real secrets in this example file.

# Backend
APP_ENV=development

# Supabase
# URL shape: https://YOUR_PROJECT_REF.supabase.co
# KEY: paste your publishable (anon) key into backend/.env only — never commit it.
# Do not use the secret/service-role key in this app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=

# AI provider: gemini | mock
# Set AI_PROVIDER=gemini and provide your free-tier Google Gemini API key.
# If GEMINI_API_KEY is unset or the API is unreachable, the system gracefully falls back to mock.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Default supported model on Google AI Studio free tier: gemini-2.5-flash (or gemini-2.5-flash-lite)
AI_MODEL=gemini-2.5-flash

# Optional CORS configuration (Vercel and localhost are allowed by default)
# FRONTEND_URL=https://personalized-travel-itinerary-planner-eta.vercel.app
# ALLOWED_ORIGINS=https://your-custom-domain.com

